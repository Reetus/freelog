# How long logs are kept (VictoriaLogs units: h, d, w, y). Oldest data is also deleted once FREELOG_MAX_DISK is hit.
FREELOG_RETENTION=14d
FREELOG_MAX_DISK=20GiB
# Tags for container logs collected on this host.
FREELOG_ENV=production
FREELOG_HOST=docker-host-1
FREELOG_RELAY_PORT=5080
FREELOG_UI_PORT=9428
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=change-me

# GlitchTip (only with --profile glitchtip)
GLITCHTIP_SECRET_KEY=change-me-openssl-rand-hex-32
GLITCHTIP_DB_PASSWORD=change-me
GLITCHTIP_DOMAIN=http://localhost:8000
# Hostnames GlitchTip answers to; keep "glitchtip" (used by the relay) and add your public hostname.
GLITCHTIP_ALLOWED_HOSTS=localhost,127.0.0.1,glitchtip
GLITCHTIP_PORT=8000
# How long error events are kept.
GLITCHTIP_RETENTION_DAYS=30
# smtp://user:password@smtp.example.com:587  (consolemail:// just prints emails to the container log)
GLITCHTIP_EMAIL_URL=consolemail://
GLITCHTIP_FROM_EMAIL=glitchtip@example.com
# Set to False after creating your account.
GLITCHTIP_ENABLE_REGISTRATION=True
