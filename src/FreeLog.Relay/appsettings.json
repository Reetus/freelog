{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "FreeLog": {
    "VictoriaLogs": {
      "Url": "http://localhost:9428",
      "StreamFields": "service,env"
    },
    "Queue": {
      "Capacity": 100000,
      "MaxBatchSize": 1000,
      "FlushIntervalMs": 1000,
      "MaxRetries": 5
    },
    "Projects": []
  }
}
