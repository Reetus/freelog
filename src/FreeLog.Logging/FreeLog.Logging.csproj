<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>FreeLog.Logging</PackageId>
    <Version>0.1.0</Version>
    <Description>Ships Microsoft.Extensions.Logging output (with exceptions and scopes) to freelog-relay via the Sentry SDK's structured logs. Self-hosted, no-budget logging with VictoriaLogs.</Description>
    <Authors>Reetus</Authors>
    <PackageTags>logging;sentry;victorialogs;self-hosted;microsoft-extensions-logging</PackageTags>
    <PackageProjectUrl>https://github.com/Reetus/freelog</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Reetus/freelog</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.14" />
    <PackageReference Include="Sentry.Extensions.Logging" Version="6.12.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
